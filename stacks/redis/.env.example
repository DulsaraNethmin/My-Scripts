# stacks/redis — copy to ~/.spinup/env/redis.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for Redis itself.
REDIS_PORT=6379

# Redis requires this password (redis-server --requirepass). Unlike the SQL
# stacks this IS re-read on every start, so changing it takes effect right
# away — no need to destroy the volume.
REDIS_PASSWORD=spinup

# Host port for the RedisInsight web UI (gui profile).
REDISINSIGHT_PORT=8083
