# stacks/chroma — copy to ~/.spinup/env/chroma.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the HTTP API. 8000 is Chroma's own default and also the default
# of half the Python web servers ever written, so this is the line to change
# when `spin up chroma` reports the port is taken.
CHROMA_PORT=8000
