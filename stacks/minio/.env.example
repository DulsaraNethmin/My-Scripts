# stacks/minio — copy to ~/.spinup/env/minio.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the S3 API — the endpoint an SDK connects to.
MINIO_PORT=9000

# Host port for the web console.
MINIO_CONSOLE_PORT=8086

# Root credentials, used for both the console and the S3 API. MinIO refuses to
# start if the password is shorter than 8 characters. Changing these after the
# data volume exists has no effect — run `spinup destroy minio` first.
MINIO_ROOT_USER=spinup
MINIO_ROOT_PASSWORD=spinup-secret
# A password with characters that mean something in a URL (@ : / ?) has to be
# percent-encoded to keep `spinup cli minio` working: it reaches mc through
# MC_HOST_local, which is a URL.

# What the console tells the browser to redirect to. Keep it in step with
# MINIO_CONSOLE_PORT if you change that.
MINIO_BROWSER_URL=http://localhost:8086
