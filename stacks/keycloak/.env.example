# stacks/keycloak — copy to ~/.spinup/env/keycloak.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for Keycloak — the admin console and every realm endpoint.
KEYCLOAK_PORT=8096

# The first admin account, created once on an empty database. Changing these
# afterwards has no effect; change the password in the console, or run
# `spinup destroy keycloak`.
KEYCLOAK_ADMIN=spinup
KEYCLOAK_ADMIN_PASSWORD=spinup

# Keycloak's own Postgres, which is not published. Nothing outside the stack
# needs these.
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
