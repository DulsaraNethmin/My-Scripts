# stacks/pgvector — copy to ~/.spinup/env/pgvector.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port. 5433, not 5432: the postgres stack has that one, and the two are
# meant to be able to run side by side.
PGVECTOR_PORT=5433

# Superuser created on first start. Named PGVECTOR_* rather than POSTGRES_* on
# purpose — docker compose gives your shell precedence over this file, so a
# POSTGRES_PASSWORD exported for something else would otherwise silently
# reconfigure this stack. Changing these after the data volume exists has no
# effect; run `spin destroy pgvector` first.
PGVECTOR_USER=spinup
PGVECTOR_PASSWORD=spinup

# Database created on first start, with the vector extension already in it.
PGVECTOR_DB=spinup
