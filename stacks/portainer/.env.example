# stacks/portainer — copy to ~/.spinup/env/portainer.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the Portainer web UI.
PORTAINER_PORT=8089

# The admin account is created on first start and stored in the data volume.
# Changing this afterwards has no effect — change it in the UI, or run
# `spinup destroy portainer` to start over. Twelve characters is what
# Portainer's own password form demands, so the default clears that bar.
PORTAINER_ADMIN_PASSWORD=spinupspinup

# The host's Docker socket, which is what Portainer manages. On Windows this
# is //./pipe/docker_engine instead.
PORTAINER_DOCKER_SOCK=/var/run/docker.sock
