# stacks/mysql — copy to ~/.spinup/env/mysql.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for MySQL itself.
MYSQL_PORT=3306

# Root password. Only read when the data volume is empty.
MYSQL_ROOT_PASSWORD=spinup

# Unprivileged user created on first start, granted full rights on
# MYSQL_DATABASE. MySQL rejects "root" here — it already exists.
MYSQL_USER=spinup
MYSQL_PASSWORD=spinup

# Database created on first start.
MYSQL_DATABASE=spinup

# Host port for the phpMyAdmin web UI (gui profile).
PHPMYADMIN_PORT=8081

# Max import size in phpMyAdmin. The stock default is 2M, which rejects
# most real dumps.
PHPMYADMIN_UPLOAD_LIMIT=300M
