# stacks/postgres — copy to ~/.spinup/env/postgres.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for Postgres itself.
POSTGRES_PORT=5432

# Superuser created on first start. Changing these after the data volume
# exists has no effect — run `spinup destroy postgres` first.
POSTGRES_USER=spinup
POSTGRES_PASSWORD=spinup

# Database created on first start.
POSTGRES_DB=spinup

# Host port for the pgAdmin web UI (gui profile).
PGADMIN_PORT=8080

# pgAdmin login. pgAdmin validates this and rejects reserved TLDs such as
# .local or .test, so use a real-looking domain (example.com is reserved by
# RFC 2606 and can never belong to anyone).
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=spinup
