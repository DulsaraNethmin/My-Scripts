# stacks/localstack — copy to ~/.spinup/env/localstack.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the gateway — the one endpoint every AWS service is behind.
LOCALSTACK_PORT=4566

# 1 turns on request logging, which is what you want when a call is being
# rejected and the SDK will not say why.
LOCALSTACK_DEBUG=0

# The host's Docker socket. LocalStack starts a container per Lambda
# invocation through it. On Windows this is //./pipe/docker_engine instead.
LOCALSTACK_DOCKER_SOCK=/var/run/docker.sock
