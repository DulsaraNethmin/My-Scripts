# stacks/couchdb — copy to ~/.spinup/env/couchdb.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the HTTP API. Fauxton, the web GUI, is on the same port
# at /_utils — CouchDB serves it itself.
COUCHDB_PORT=5984

# The server admin. Re-applied from these values on every start, so unlike most
# database stacks changing them here does take effect.
COUCHDB_USER=spinup
COUCHDB_PASSWORD=spinup

# Secret used to sign session cookies. Fixed so a restart does not log you out.
COUCHDB_SECRET=spinup-local-secret
