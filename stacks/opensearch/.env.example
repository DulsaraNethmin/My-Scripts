# stacks/opensearch — copy to ~/.spinup/env/opensearch.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the REST API.
OPENSEARCH_PORT=9200

# Host port for OpenSearch Dashboards (gui profile).
OPENSEARCH_DASHBOARDS_PORT=8094

# What the cluster calls itself. Cosmetic on one node.
OPENSEARCH_CLUSTER_NAME=spinup

# JVM heap, set as both -Xms and -Xmx. Left alone the JVM takes a quarter of
# the host's RAM, which on a laptop running other stacks is too much.
OPENSEARCH_HEAP=512m
