# stacks/nginx-static — copy to ~/.spinup/env/nginx-static.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the site.
NGINX_PORT=8090

# What to serve. Leave as the named volume `nginx-site` to use the placeholder
# page baked into the image, or set an absolute path to serve a folder from your
# machine — Compose treats any value starting with / or . as a bind mount:
#
#   NGINX_SITE=/Users/you/project/dist
#
NGINX_SITE=nginx-site
