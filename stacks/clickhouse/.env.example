# stacks/clickhouse — copy to ~/.spinup/env/clickhouse.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the HTTP interface. Play, the built-in query UI, is on the same
# port at /play — ClickHouse serves it itself.
CLICKHOUSE_HTTP_PORT=8123

# Host port for the native protocol, which clickhouse-client and the native
# drivers speak. 9001, not the native 9000: the minio stack has that one.
CLICKHOUSE_NATIVE_PORT=9001

# Setting a user replaces `default` rather than adding to it, so there is no
# passwordless account left behind. Applied on first start only.
CLICKHOUSE_USER=spinup
CLICKHOUSE_PASSWORD=spinup
CLICKHOUSE_DB=spinup
