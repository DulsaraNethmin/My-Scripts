# stacks/neo4j — copy to ~/.spinup/env/neo4j.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the Bolt protocol — what drivers and cypher-shell connect to.
NEO4J_BOLT_PORT=7687

# Host port for Neo4j Browser, which the database serves itself on 7474.
NEO4J_BROWSER_PORT=8091

# Password for the built-in `neo4j` user. Neo4j requires at least 8 characters.
# Set on first start only; `spinup destroy neo4j` to change it afterwards.
NEO4J_PASSWORD=spinuppass
