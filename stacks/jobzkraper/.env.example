# stacks/jobzkraper — copy to ~/.spinup/env/jobzkraper.env and edit as needed.
# Every uncommented value here is the default baked into compose.yaml; the
# commented ones are optional and empty until you uncomment them.
#
# The scraper's searches and CV profile are NOT here: they live in the
# jobzkraper-config volume, written by `spin cli jobzkraper -- init`.

# The scheduler fires on LOCAL wall clock. Set your timezone (Asia/Colombo,
# Europe/London, …) or the times below are UTC times.
TZ=UTC

# Firing times: HH:MM, comma-separated for more than one.
JOBSCRAPER_SCRAPE_AT=06:00,18:00
JOBSCRAPER_DIGEST_AT=07:00

# NordVPN service credentials (Nord account -> Services -> manual setup), only
# needed if your config routes any source through the SOCKS5 proxy.
# NORDVPN_SOCKS_USER=
# NORDVPN_SOCKS_PASS=

# Your expected public IP. Sources configured to refuse a VPN exit check they
# really are leaving from this address before scraping.
# JOBSCRAPER_HOME_IP=

# A webhook URL to receive the morning digest. Unset means no webhook; the
# digest is still written into the jobzkraper-data volume.
# JOBSCRAPER_DIGEST_WEBHOOK=
