# stacks/mssql — copy to ~/.spinup/env/mssql.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for SQL Server.
MSSQL_PORT=1433

# SA password. SQL Server enforces its own complexity policy: at least 8
# characters drawn from three of uppercase, lowercase, digits and symbols.
# A weak password does not fail loudly — the server simply refuses to start.
MSSQL_SA_PASSWORD=Spinup!Passw0rd

# Edition. Developer is free and feature-complete for non-production use.
# Also valid: Express, Standard, Enterprise, EnterpriseCore.
MSSQL_EDITION=Developer

# You must accept the Microsoft EULA for the image to start.
# https://go.microsoft.com/fwlink/?linkid=857698
MSSQL_ACCEPT_EULA=Y
