# stacks/rabbitmq — copy to ~/.spinup/env/rabbitmq.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for AMQP — what a client library connects to.
RABBITMQ_PORT=5672

# Host port for the management UI.
RABBITMQ_MANAGEMENT_PORT=8087

# The user created on first start, for both AMQP and the management UI.
# Changing these after the data volume exists has no effect — run
# `spinup destroy rabbitmq` first.
RABBITMQ_USER=spinup
RABBITMQ_PASSWORD=spinup

# The default virtual host. "/" is what every client assumes.
RABBITMQ_VHOST=/
