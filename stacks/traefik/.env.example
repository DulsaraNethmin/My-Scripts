# stacks/traefik — copy to ~/.spinup/env/traefik.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the `web` entrypoint — where routed traffic arrives. 8098
# rather than 80, which the nginx-proxy-manager stack owns and which needs
# root on Linux.
TRAEFIK_HTTP_PORT=8098

# Host port for the dashboard.
TRAEFIK_DASHBOARD_PORT=8092

# DEBUG spells out why a router did not match, which is most of what goes
# wrong. INFO, WARN and ERROR are the quieter ones.
TRAEFIK_LOG_LEVEL=INFO

# The host's Docker socket, mounted read-only. Traefik reads container labels
# through it. On Windows this is //./pipe/docker_engine instead.
TRAEFIK_DOCKER_SOCK=/var/run/docker.sock
