# stacks/nginx-proxy-manager — copy to ~/.spinup/env/nginx-proxy-manager.env.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Public HTTP and HTTPS ports. This stack is a reverse proxy, so it wants the
# real web ports. On Linux, binding below 1024 may need extra privileges.
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443

# The admin UI. Never expose this one to the internet.
NPM_ADMIN_PORT=81
