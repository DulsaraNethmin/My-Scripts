# stacks/mailpit — copy to ~/.spinup/env/mailpit.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port your app sends SMTP to.
MAILPIT_SMTP_PORT=1025

# Host port for the web inbox.
MAILPIT_UI_PORT=8085

# How many messages to keep before the oldest are dropped. 0 keeps everything.
MAILPIT_MAX_MESSAGES=5000

# Accept any username and password, and accept auth without TLS. Both are on
# because a local mail catcher is there to be pointed at, and many frameworks
# will not send without an auth mechanism. Set to false to reject auth.
MAILPIT_ACCEPT_ANY_AUTH=true
MAILPIT_ALLOW_INSECURE_AUTH=true
