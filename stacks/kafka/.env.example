# stacks/kafka — copy to ~/.spinup/env/kafka.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the broker. Clients on your machine bootstrap against
# localhost:9092; containers on the stack's own network use kafka:9092.
KAFKA_PORT=9092

# Host port for kafka-ui (gui profile).
KAFKA_UI_PORT=8093

# What the cluster is called in kafka-ui's sidebar.
KAFKA_CLUSTER_NAME=local

# Producing to a topic that does not exist creates it. Convenient locally, and
# the reason a typo in a topic name is silently a new topic — set false to
# have Kafka refuse instead.
KAFKA_AUTO_CREATE_TOPICS=true
