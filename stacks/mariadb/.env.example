# stacks/mariadb — copy to ~/.spinup/env/mariadb.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for MariaDB. 3307, not 3306: the mysql stack has that one, and
# both have to be able to run at once.
MARIADB_PORT=3307

# Created on first start. Changing these after the data volume exists has no
# effect — run `spinup destroy mariadb` first.
MARIADB_DATABASE=spinup
MARIADB_USER=spinup
MARIADB_PASSWORD=spinup
MARIADB_ROOT_PASSWORD=spinup

# Host port for Adminer (gui profile).
MARIADB_ADMINER_PORT=8097
