# stacks/vault — copy to ~/.spinup/env/vault.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the API and the built-in UI, which share it.
VAULT_PORT=8200

# The root token. In dev mode it is fixed rather than generated, so scripts and
# the UI can log in without reading it out of the container's logs.
VAULT_TOKEN=spinup-root-token
