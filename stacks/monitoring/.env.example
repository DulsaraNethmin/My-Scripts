# stacks/monitoring — copy to ~/.spinup/env/monitoring.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for Prometheus. Its own query UI is on it, at /graph.
PROMETHEUS_PORT=9090

# Host port for Grafana (gui profile).
GRAFANA_PORT=8095

# Grafana's admin account. Applied on first start only; after that it lives in
# the grafana-data volume.
GRAFANA_USER=spinup
GRAFANA_PASSWORD=spinup

# How long Prometheus keeps samples. Fifteen days of two exporters is a few
# hundred megabytes.
PROMETHEUS_RETENTION=15d

# The host's Docker socket, mounted read-only into cAdvisor so it can put
# container names on its metrics. On Windows this is //./pipe/docker_engine.
MONITORING_DOCKER_SOCK=/var/run/docker.sock
