# stacks/weaviate — copy to ~/.spinup/env/weaviate.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the REST and GraphQL API. 9080, not Weaviate's own 8080:
# pgAdmin in the postgres stack has that one. Clients have to be told — the
# Python client's connect_to_local() assumes 8080 unless you pass port=9080.
WEAVIATE_HTTP_PORT=9080

# Host port for gRPC, which the v4 Python and v3 TypeScript clients need for
# batch writes and search. 50051 is the canonical gRPC port and so the likeliest
# default in this catalog to already be taken on your machine.
WEAVIATE_GRPC_PORT=50051

# How many objects a query returns when it does not say. Weaviate's own
# default; raise it if your searches keep truncating.
WEAVIATE_QUERY_LIMIT=25
