# stacks/mongodb — copy to ~/.spinup/env/mongodb.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for MongoDB itself.
MONGO_PORT=27017

# Root user created on first start. Only read when the data volume is empty.
MONGO_USER=spinup
MONGO_PASSWORD=spinup

# Database that init/ scripts run against. Mongo creates databases lazily,
# so this one only materialises once something is written to it.
MONGO_DB=spinup

# Host port for the mongo-express web UI (gui profile).
MONGO_EXPRESS_PORT=8082

# mongo-express 1.x puts its whole UI behind HTTP basic auth. This is that
# login, not the MongoDB one.
MONGO_EXPRESS_USER=spinup
MONGO_EXPRESS_PASSWORD=spinup
