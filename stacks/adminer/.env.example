# stacks/adminer — copy to ~/.spinup/env/adminer.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the Adminer page.
ADMINER_PORT=8084

# What the login form's "Server" field starts on. host.docker.internal is your
# own machine seen from inside the container, which is where spinup's databases
# publish their ports.
ADMINER_DEFAULT_SERVER=host.docker.internal
