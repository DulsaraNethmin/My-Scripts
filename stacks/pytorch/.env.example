# stacks/pytorch — copy to ~/.spinup/env/pytorch.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for JupyterLab.
JUPYTER_PORT=8888

# Host port for TensorBoard. Nothing listens here until you start TensorBoard
# yourself from a notebook terminal.
TENSORBOARD_PORT=6006

# JupyterLab access token — this is the whole authentication story, so treat
# it as a password. Open http://localhost:8888/lab?token=<this>
JUPYTER_TOKEN=spinup
