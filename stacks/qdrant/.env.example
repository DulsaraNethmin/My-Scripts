# stacks/qdrant — copy to ~/.spinup/env/qdrant.env and edit as needed.
# Every value here is the default baked into compose.yaml; uncomment to override.

# Host port for the REST API. The web dashboard is on this same port, at
# /dashboard — Qdrant serves it itself rather than from a second container.
QDRANT_HTTP_PORT=6333

# Host port for the gRPC API, which the official clients prefer.
QDRANT_GRPC_PORT=6334

# Sent as the `api-key` header. Re-read on every start, so changing it takes
# effect immediately — no destroy needed. /healthz, /readyz and the dashboard
# shell are exempt; /collections and everything under it are not. Set it to
# nothing at all to turn authentication off.
QDRANT_API_KEY=spinup
